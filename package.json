{
  "name": "dsh-mobile-web-gui",
  "description": "DeepSeek Harness bundle serving the no-build mobile web GUI for commanding and orchestrating sessions",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "client/**/*",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "mock": "node mock/server.js"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-brand": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.5-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "tsdown": "^0.22.2"
  }
}
